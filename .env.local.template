# Lattice gateway environment (all optional).
# Copy to .env.local and uncomment what you need.
#
# Gateway behavior (caching, rate limiting, auth, tracing, plugins) is
# configured in lattice.yaml, not through environment variables.

# Log verbosity (error, warn, info, debug, trace). Overrides lattice.yaml log_level.
# RUST_LOG=info

# Host port mapped to the gateway (the container always listens on 4000).
# GATEWAY_PORT=4000
