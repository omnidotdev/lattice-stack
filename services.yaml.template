# Lattice Services Configuration
# Copy to services.yaml and customize
#
# Format:
#   services:
#     - name:
#         repo: repository URL (required)
#         path: local path (optional, defaults to services/name)
#         env: environment variables (optional)

services:
  # Lattice - federated GraphQL gateway
  - lattice:
      repo: git@github.com:omnidotdev/lattice#master

  # Lattice site - marketing/landing page
  - lattice-site:
      repo: git@github.com:omnidotdev/lattice-site#master
